# Embedding model used by vector retrieval
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Optional stronger embedding model for a GPU machine:\n# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B\n# EMBED_BATCH_SIZE=8\n\n# Optional OpenAI-compatible answering model.
# Leave blank to run the app in evidence-only mode.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Retrieval defaults
BM25_TOP_K=10
VECTOR_TOP_K=10
FINAL_TOP_K=8
